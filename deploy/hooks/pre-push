#!/bin/zsh
set -uo pipefail

# The release gate, in front of every push. Install it with:
#
#   ln -sf ../../deploy/hooks/pre-push .git/hooks/pre-push
#
# It exists because this repository has no working CI. GitHub Actions has never produced a run
# here, and while the account is restricted it cannot: the workflow is registered and enabled,
# and pushes create nothing. Rather than leave the gate imaginary, it runs here.
#
# Two environments, because the failures they catch are different ones and neither finds the
# other's:
#
#   a temporary worktree at the commit being pushed, with no state/, runs/ or .env
#       The shape of checkout anyone else gets — CI, a fresh clone, a second machine. Two
#       preflight tests read the deployment's own state directory for months and passed only
#       because this machine has one.
#
#   this deployment's stored documents, read through the API's response models
#       Which CI could never do: the fixtures a test writes come from the shape a constructor
#       produces, and what is on disk is the shape every later pass left behind. That is how a
#       stored holding came to carry two fields /advisor would have answered 500 over.
#
# Read-only throughout, and offline: no venue session, no Claude quota, nothing written to
# state/. Takes about two minutes. `git push --no-verify` skips it, which is the right move for
# a branch nobody will pull and the wrong one for anything going to main.

project_dir="$(cd "$(dirname "$0")/../.." && pwd -P)"
cd "$project_dir"

# pre-push receives "<local ref> <local sha> <remote ref> <remote sha>" per ref on stdin.
# A deletion arrives as an all-zero local sha and has no tree to check.
# Every distinct commit is checked. This took the first line only, so pushing a branch and a tag,
# or two branches, checked one commit and let the others through unexamined.
typeset -U pushed
pushed=()
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" =~ '^0+$' ]] && continue
  pushed+=("$local_sha")
done
if (( ${#pushed} == 0 )); then
  exit 0
fi

fails=0
step() {
  local label="$1"; shift
  print -r -- "── $label"
  if "$@"; then
    print -r -- "   ok"
  else
    print -r -- "   FAILED"
    fails=$((fails + 1))
  fi
}

# Honours TMPDIR explicitly rather than leaving it to mktemp's default, and refuses to carry
# on without a directory: an unchecked failure here leaves the path empty, and the worktree
# that follows is then created against the filesystem root.
worktree="$(mktemp -d "${TMPDIR:-/tmp}/ct-prepush.XXXXXX")" || {
  print -r -- "pre-push: could not create a temporary directory; refusing to guess" >&2
  exit 1
}
cleanup() {
  local checkout
  for checkout in "$worktree"/checkout-*(N); do
    git worktree remove --force "$checkout" 2>/dev/null
  done
  git worktree prune
  rm -rf "$worktree"
}
trap cleanup EXIT INT TERM

bare_checkout() {
  local commit="$1" checkout="$worktree/checkout-${1[1,12]}"
  git worktree add --detach --quiet "$checkout" "$commit" || return 1
  # The interpreter is the one this checkout already resolved. A worktree has no .venv of its
  # own and building a second one would check a different set of wheels than the release does.
  ln -sfn "$project_dir/.venv" "$checkout/.venv"
  "$checkout/deploy/checks.sh"
}

stored_documents() {
  .venv/bin/python tools/validate_stored_shapes.py --config-dir "$project_dir/config"
}

for commit in "${pushed[@]}"; do
  print -r -- "pre-push: ${commit[1,12]}"
  step "bare checkout ${commit[1,12]}"  bare_checkout "$commit"
done
step "stored documents"   stored_documents

print -r -- ""
if (( fails )); then
  print -r -- "$fails gate(s) failed; push refused. Override with: git push --no-verify"
  exit 1
fi
print -r -- "every gate passed"
