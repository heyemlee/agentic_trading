# Copy to .env if you need data keys. TradingAgents loads this file automatically.
#
# DO NOT set ANTHROPIC_API_KEY anywhere. The LLM layer runs on your Claude Max
# subscription through the Claude Code CLI; an API key would switch billing to
# pay-as-you-go. The adapter also strips these variables before every call.
#
# Optional, free: FRED macro data (rates, inflation, VIX) for the News Analyst.
# Without it the macro tool degrades to a "data unavailable" sentinel.
FRED_API_KEY=
# Optional: only if you change data_vendors in config/investor_profile.yaml.
ALPHA_VANTAGE_API_KEY=
