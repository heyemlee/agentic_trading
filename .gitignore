.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
runs/
# The bare names, not just the trailing-slash directory forms: in a data-dir-separated
# install, state and runs are symlinks pointing outside the checkout, and a symlink never
# matches a "name/" rule. Without this, an ordinary `git add -A` would track the symlink
# itself, leaking a local absolute path into a public repository.
state
runs
.env
.env.*
!.env.example
state/risk_state.json
state/micro_live_risk_state.json
state/robinhood_token.json
state/proposals.json
state/simulated_orders.json
state/fills.jsonl
state/HALT
state/console_auth.json
state/vapid_key.json
state/*.lock
state/*.sqlite3
state/*.sqlite3-*
state/*.execution
state/backups/
.DS_Store
state/portfolio.yaml
state/micro_live_portfolio.yaml
